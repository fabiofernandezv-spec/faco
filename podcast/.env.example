# AgendaCR Podcast — variables de entorno
# Copiá este archivo como .env y completá tus valores

# --- Generación de guion (obligatorio) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# --- Texto a voz (elegí uno) ---
TTS_PROVIDER=elevenlabs
# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Alternativa más económica: OpenAI TTS (no da timestamps por palabra,
# los subtítulos se estiman por duración)
OPENAI_API_KEY=

# --- Publicación (opcional, dejar vacío para solo generar los archivos) ---

# YouTube Data API v3 — https://console.cloud.google.com/apis/credentials
# Requiere OAuth2 con el scope youtube.upload ya autorizado una vez
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# TikTok Content Posting API — https://developers.tiktok.com/
TIKTOK_ACCESS_TOKEN=

# URL pública base donde se alojarán los mp3 (para el feed RSS del podcast,
# ej. un bucket S3/Supabase Storage). Requerido solo si generás el feed.
PODCAST_AUDIO_BASE_URL=
